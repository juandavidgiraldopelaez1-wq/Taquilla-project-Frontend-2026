# Dirección base de la API (obligatoria)
VITE_API_URL=https://yanethm-taquilla-api.fly.dev/api/v1

# Opcionales: pruebas de estados de carga y error (US-TAQ-S2-02).
# También se pueden activar en el navegador con ?simularLatencia=2000
# o ?simularError=503 (y quitarlos con ?simularError=).
# Milisegundos de espera, por ejemplo 2000:
VITE_SIMULAR_LATENCIA=
# Código de error simulado: 500, 503 o 504:
VITE_SIMULAR_ERROR=
